// Reference Wrangler config (equivalent to cloudflare.config.ts). Used for local `wrangler dev`.
{
  "name": "chess-vasanth",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-02",
  "routes": [{ "pattern": "chess.vasanth.cloud", "custom_domain": true }],
  "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "ai": { "binding": "AI" },
  "ratelimits": [
    { "name": "RL_IP", "namespace_id": "1793608201", "simple": { "limit": 12, "period": 60 } },
    { "name": "RL_GLOBAL", "namespace_id": "1793608202", "simple": { "limit": 16, "period": 60 } }
  ]
}
